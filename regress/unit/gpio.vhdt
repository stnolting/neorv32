--! dut neorv32_gpio
--! generic GPIO_NUM=32
--! generic GPIO_DIR=true
--! config gpio_32 GPIO_NUM=32
--! config gpio_8 GPIO_NUM=8
--! config gpio_nodir GPIO_NUM=4 GPIO_DIR=false
--! stim
  tick(5);
  wr(x"00000004", x"A5A5A5A5"); -- out
  wr(x"00000008", x"0F0F0F0F"); -- dir
  for i in 0 to 7 loop
    rd(std_ulogic_vector(to_unsigned(i * 4, 32)));
  end loop;
  -- every trigger type and polarity
  for m in 0 to 3 loop
    wr(x"0000000C", replicate_f(bool_to_ulogic_f(m >= 2), 32));
    wr(x"00000010", replicate_f(bool_to_ulogic_f((m mod 2) = 1), 32));
    wr(x"00000014", x"FFFFFFFF");
    port_in_i <= x"FFFFFFFF";
    tick(4);
    rd(x"00000018");
    wr(x"00000018", x"00000000");
    port_in_i <= x"00000000";
    tick(4);
    rd(x"00000018");
    wr(x"00000018", x"00000000");
    tick(2);
    wr(x"00000014", x"00000000");
    tick(2);
  end loop;
  for i in 1 to 300 loop
    port_in_i <= randv(32);
    fuzz(5, 2);
  end loop;
