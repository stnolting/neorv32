--! dut neorv32_cpu_frontend
--! generic HART_ID=0
--! generic RISCV_C=true
--! generic RISCV_ZCB=true
--! generic RISCV_ZCMOP=true
--! config frontend_c
--! config frontend_noc RISCV_C=false RISCV_ZCB=false RISCV_ZCMOP=false
--! arch
  mem: entity neorv32.regress_bus_mem generic map (LATENCY => 2) port map (clk_i => clk_i, req_i => ibus_req_o, rsp_o => ibus_rsp_i);
--! stim
  -- procs
    procedure restart(a : std_ulogic_vector(31 downto 0)) is
    begin
      ctrl_i.pc_nxt <= a;
      ctrl_i.if_reset <= '1';
      tick;
      ctrl_i.if_reset <= '0';
    end procedure;
  -- end procs
  tick(4);
  ctrl_i.if_ready <= '1';
  restart(x"00000000");
  tick(100);
  restart(x"00000002"); -- unaligned
  tick(40);
  ctrl_i.if_ready <= '0';
  tick(30);
  ctrl_i.if_ready <= '1';
  tick(20);
  -- random flow
  for i in 1 to 400 loop
    ctrl_i.if_ready <= randv(1)(0);
    if rndn(15) = 0 then
      restart(x"000000" & randv(7) & '0');
    end if;
    if rndn(63) = 0 then
      ctrl_i.if_fence <= '1';
      tick;
      ctrl_i.if_fence <= '0';
    end if;
    pmp_err_i <= bool_to_ulogic_f(rndn(31) = 0);
    tick;
  end loop;
  pmp_err_i <= '0';
  -- bus error
  restart(x"E0000000");
  ctrl_i.if_ready <= '1';
  tick(40);
  ctrl_i.cpu_priv <= '1';
  ctrl_i.cpu_debug <= '1';
  restart(x"00000000");
  tick(20);
