--! dut neorv32_cpu_alu_fpu_normalizer
--! generic FPU_SUBNORMAL_SUPPORT=false
--! config fpu_norm
--! config fpu_norm_sub FPU_SUBNORMAL_SUPPORT=true
--! stim
  tick(4);
  for i in 1 to 3000 loop
    rmode_i <= randv(3);
    funct_i <= randv(1)(0);
    sign_i <= randv(1)(0);
    exponent_i <= randv(9);
    mantissa_i <= randv(48);
    if rndn(1) = 0 then
      mantissa_i <= (others => '0');
      mantissa_i(rndn(47)) <= '1';
    end if;
    integer_i <= randv(32);
    class_i <= (others => '0');
    if rndn(1) = 0 then
      class_i(rndn(9)) <= '1';
    end if;
    flags_i <= randv(5);
    start_i <= '1';
    tick;
    start_i <= '0';
    if rndn(31) = 0 then
      tick(rndn(8));
      abort_i <= '1';
      tick;
      abort_i <= '0';
      tick(2);
    else
      for n in 0 to 100 loop
        tick;
        exit when done_o = '1';
      end loop;
      tick;
    end if;
  end loop;
